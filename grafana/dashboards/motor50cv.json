      }],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "Severidade" }, "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-background" } }, { "id": "mappings", "value": [{ "type": "value", "options": { "CRITICAL": { "color": "red", "text": "🔴 CRÍTICO" }, "HIGH": { "color": "orange", "text": "🟠 ALTO" }, "MEDIUM": { "color": "yellow", "text": "🟡 MÉDIO" } } }] }] },
