      "targets": [{
        "refId": "A",
        "method": "GET",
        "urlPath": "/api/v1/motor/alarms?limit=10",
        "fields": [
          { "jsonPath": "$.alarms[*].timestamp", "name": "Data/Hora" },
          { "jsonPath": "$.alarms[*].category", "name": "Categoria" },
          { "jsonPath": "$.alarms[*].severity_name", "name": "Severidade" },
