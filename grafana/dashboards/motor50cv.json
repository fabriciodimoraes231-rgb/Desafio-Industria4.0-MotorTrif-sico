    {
      "type": "stat",
      "title": "Total Alarmes",
      "gridPos": { "h": 3, "w": 4, "x": 0, "y": 1 },
      "id": 201,
      "datasource": { "type": "marcusolsson-json-datasource", "uid": "PC2F003280D19B538" },
      "targets": [{ "refId": "A", "method": "GET", "urlPath": "/api/v1/motor/alarms?limit=1000", "fields": [{ "jsonPath": "$.active_count", "name": "Ativos" }] }],
      "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 10 }] } } },
