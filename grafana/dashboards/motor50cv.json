      "gridPos": { "h": 3, "w": 4, "x": 0, "y": 4 },
      "id": 401,
      "datasource": { "type": "marcusolsson-json-datasource", "uid": "PC2F003280D19B538" },
      "targets": [{ "refId": "A", "method": "GET", "urlPath": "/health", "fields": [{ "jsonPath": "$.status", "name": "Status" }] }],
      "fieldConfig": { 
        "defaults": { 
          "mappings": [{ "type": "value", "options": { "healthy": { "text": "ONLINE", "color": "green" } } }, { "type": "special", "options": { "match": "null", "result": { "text": "OFFLINE", "color": "red" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
