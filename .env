# Broker MQTT Externo
MQTT_BROKER=lse.dev.br
MQTT_PORT=1883

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASS=admin123

# OPC UA Server
OPCUA_ENDPOINT=opc.tcp://0.0.0.0:4840/motor50cv/server

# API Service
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./data/motor.db

# Grafana
GRAFANA_USER=admin
GRAFANA_PASS=admin123

# MQTT Producer (Simulador)
PRODUCER_ALARM_RATE=0.1
PRODUCER_INTERVAL=2.0
